# Chemin racine où les PDFs seront archivés
ARCHIVE_PATH=C:\Users\arman\Archives\Journaux

# Décommenter pour lancer le navigateur en mode visible (utile pour le débogage)
# DEBUG=true

# Dossier des sessions de connexion (défaut : .browser_state/ dans le projet)
# BROWSER_STATE_DIR=C:\Users\arman\Archives\.sessions

# Supervision facultative (Healthchecks.io, vide = désactivée) : URL de ping du check (https://hc-ping.com/<uuid>).
# Envoie des données à un service tiers. `python run.py` envoie start puis ok ou fail (avec les erreurs par source).
# HEARTBEAT_URL=
# Pour une tâche planifiée par source, un check par tâche : HEARTBEAT_URL_<SOURCE> l'emporte sur HEARTBEAT_URL
# lorsque `python run.py <source>` est lancé (LE_COURRIER, 24HEURES, LETEMPS, LEMONDE).
# HEARTBEAT_URL_LE_COURRIER=
